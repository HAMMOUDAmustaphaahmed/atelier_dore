# Copiez ce fichier en `.env.local` pour le développement (`vercel dev` le lit automatiquement).
# En production : Vercel → Project → Settings → Environment Variables.
# Aucune de ces valeurs n'est exposée au navigateur (pas de préfixe VITE_).

# --- Modèle de Léa ---
# LLM_PROVIDER=anthropic → Claude (recommandé, payant) · LLM_PROVIDER=groq → Groq (gratuit, modèles open source)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...
# LEA_MODEL=            # vide = défaut du fournisseur : claude-opus-5 (anthropic) / openai/gpt-oss-120b (groq)
# CHEF_MODEL=           # modèle de l'agent du propriétaire (défaut : LEA_MODEL)
# LEA_GUARD_MODEL=      # filtre de périmètre : claude-haiku-4-5 (anthropic) / openai/gpt-oss-20b (groq)
LEA_GUARD=on            # off pour désactiver le filtre (le prompt de Léa reste la 2e ligne de défense)
CHAT_OFFTOPIC_STRIKES=3 # messages hors sujet avant clôture définitive de la conversation

# --- Supabase (Project Settings → API) ---
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...            # clé "service_role", jamais la clé "anon"

# --- Sessions ---
SESSION_SECRET=changez-moi-32-caracteres-aleatoires   # ex. : openssl rand -hex 32

# --- Emails ---
# Option gratuite : votre Gmail + mot de passe d'application (Google → Sécurité → Validation en deux étapes → Mots de passe des applications)
GMAIL_USER=votre.adresse@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Option domaine : Resend (EMAIL_PROVIDER=resend force Resend même si GMAIL_USER est défini)
# EMAIL_PROVIDER=resend
# --- Emails (Resend) ---
RESEND_API_KEY=re_...
EMAIL_FROM="L'Atelier Doré <onboarding@resend.dev>"  # remplacez par votre domaine vérifié (ex. contact@atelier-dore.fr)
BAKERY_EMAIL=votre-adresse@exemple.fr                # reçoit les formulaires de contact

# --- Garde-fous (valeurs par défaut si absentes) ---
CHAT_MAX_MESSAGES_PER_SESSION=20
CHAT_MAX_MESSAGES_PER_IP_PER_DAY=40
CHAT_MAX_SESSIONS_PER_IP_PER_DAY=3
CHAT_MIN_INTERVAL_MS=2500
CHAT_MAX_INPUT_CHARS=400
CHAT_HISTORY_TURNS=12
CHAT_DAILY_TOKEN_BUDGET=2000000
CHAT_MAX_OUTPUT_TOKENS=1200

# --- Commandes (phase 2) ---
PUBLIC_SITE_URL=https://votre-site.vercel.app     # utilisé pour les liens dans les emails (déduit de la requête si absent)
CRON_SECRET=changez-moi-aussi                     # Vercel l'envoie au cron /api/cron/reminders (openssl rand -hex 16)
ORDERS_MAX_PER_SESSION=3
ORDERS_MAX_PER_EMAIL_PER_DAY=3

# --- Espace propriétaire : le Chef (phase 4) ---
ADMIN_PASSWORD=choisissez-un-mot-de-passe        # /admin sur le site et "/start <mot de passe>" sur Telegram
TELEGRAM_BOT_TOKEN=123456:ABC...                  # @BotFather → /newbot
TELEGRAM_WEBHOOK_SECRET=changez-moi               # openssl rand -hex 16 ; utilisé lors du setWebhook
